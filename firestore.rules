rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function tokenRole() {
      return signedIn() && request.auth.token.role != null
        ? request.auth.token.role
        : '';
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.isAdmin == true ||
        request.auth.token.isSuperAdmin == true ||
        tokenRole() in ['super_admin', 'admin', 'editor', 'viewer'] ||
        // Migration: Auth user with admins/{uid} doc (no custom claims yet)
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        // Temporary owner unlock until service-account claims are set
        request.auth.token.email == 'fawzymaherahmed@gmail.com'
      );
    }

    function isEditorPlus() {
      return signedIn() && (
        request.auth.token.isSuperAdmin == true ||
        tokenRole() in ['super_admin', 'admin', 'editor'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'fawzymaherahmed@gmail.com'
      );
    }

    function isSuperAdmin() {
      return signedIn() && (
        request.auth.token.isSuperAdmin == true ||
        tokenRole() == 'super_admin' ||
        request.auth.token.email == 'fawzymaherahmed@gmail.com'
      );
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function quizSession(sessionId) {
      return get(/databases/$(database)/documents/quiz_live_sessions/$(sessionId)).data;
    }

    // Anonymous players record one answer per question when server scoring is unavailable.
    function isQuizAnswerCreate(sessionId, answerId) {
      let data = request.resource.data;
      let sess = quizSession(sessionId);
      return sess.status == 'question'
        && data.playerId is string
        && data.playerId.size() > 0
        && data.playerId.size() < 128
        && data.questionIndex is int
        && data.questionIndex == sess.currentQuestionIndex
        && answerId == data.playerId + '_q' + string(data.questionIndex)
        && exists(/databases/$(database)/documents/quiz_live_sessions/$(sessionId)/players/$(data.playerId))
        && data.answer is string
        && data.answer.size() <= 2000
        && data.points is int
        && data.points >= 0
        && data.points <= 2000
        && data.correct is bool
        && data.keys().hasOnly([
          'playerId', 'nickname', 'questionIndex', 'questionType', 'answer',
          'correct', 'points', 'responseTimeMs', 'answeredAt', 'division'
        ]);
    }

    function isPlayerScoreBump() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['score', 'lastAnswerAt'])
        && request.resource.data.score is int
        && resource.data.score is int
        && request.resource.data.score >= resource.data.score
        && request.resource.data.score <= resource.data.score + 2000;
    }

    function isAnswerCountBump() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let countOk = request.resource.data.answerCount is int
        && resource.data.answerCount is int
        && request.resource.data.answerCount == resource.data.answerCount + 1;
      let keysOk = changed.hasOnly(['answerCount'])
        || (
          changed.hasOnly(['answerCount', 'status', 'revealStartedAt'])
          && resource.data.status == 'question'
          && request.resource.data.status == 'reveal'
        );
      return countOk && keysOk;
    }

    // ΓöÇΓöÇ Default deny ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
    match /{document=**} {
      allow read, write: if false;
    }

    // ΓöÇΓöÇ Public leaderboard / TCS-PQA reads; admin writes ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
    match /engineers/{id} {
      allow read: if true;
      allow write: if isEditorPlus();
    }
    match /tcs_mx_receptionists/{id} {
      allow read: if true;
      allow write: if isEditorPlus();
    }
    match /tcs_mx_galaxy_consultants/{id} {
      allow read: if true;
      allow write: if isEditorPlus();
    }
    match /tcs_da_engineers/{id} {
      allow read: if true;
      allow write: if isEditorPlus();
    }
    match /tcs_vd_engineers/{id} {
      allow read: if true;
      allow write: if isEditorPlus();
    }
    match /tcs_dashboard_winners/{id} {
      allow read: if true;
      allow write: if isEditorPlus();
    }
    match /tcs_snapshots/{id} {
      allow read: if true;
      allow create: if isEditorPlus();
      allow update, delete: if isSuperAdmin();
    }
    match /pqa_mx_centers/{id} {
      allow read: if true;
      allow write: if isEditorPlus();
    }
    match /pqa_ce_centers/{id} {
      allow read: if true;
      allow write: if isEditorPlus();
    }
    match /leaderboard_aggregates/{id} {
      allow read: if true;
      allow write: if false; // Admin SDK / Cloud Functions only
    }

    // ΓöÇΓöÇ Admins (migration-friendly reads until Auth claims are live) ΓöÇΓöÇ
    match /admins/{adminId} {
      // Temporary open access so Manage Accounts can list Jimmy/George and write profiles.
      // Tighten after every admin uses Firebase Auth + service account bootstrap.
      allow read, write: if true;
    }

    // ΓöÇΓöÇ Employees / consultants ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
    match /employees/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && !('passwordHash' in request.resource.data)
        && !('passwordSalt' in request.resource.data);
      allow update: if (isSelf(uid)
          && !('passwordHash' in request.resource.data)
          && !('passwordSalt' in request.resource.data)
          && !('role' in request.resource.data))
        || isAdmin();
      // Admins can remove employee profiles from the portal (Auth delete still needs Admin SDK)
      allow delete: if isAdmin() || isSuperAdmin();
    }
    match /employee_index/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
    match /employee_progress/{progressId} {
      // get on missing docs: resource is null — allow own path prefix so first open works
      allow get: if isAdmin()
        || (signedIn() && progressId.matches(request.auth.uid + '_.*'));
      allow list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && progressId == request.auth.uid + '_' + request.resource.data.consultantId;
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && progressId.matches(request.auth.uid + '_.*'));
      allow delete: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
    }
    match /consultants/{id} {
      allow read: if true;
      allow write: if isEditorPlus();
    }
    match /consultant_announcements/{id} {
      allow read: if true;
      allow write: if isEditorPlus();
    }

    // ΓöÇΓöÇ Survey / feedback (create + rate via App Check recommended) ΓöÇ
    match /feedback/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /samsung_academy_survey/records {
      // Display flags must be readable by all visitors (TCS popup on/off).
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /responses/{responseId} {
        allow create: if true;
        allow read, update, delete: if isAdmin();
      }
    }

    // ΓöÇΓöÇ Quiz / SCORA ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
    match /quiz_templates/{id} {
      allow read: if isAdmin();
      allow write: if isEditorPlus();
    }
    match /quiz_live_sessions/{sessionId} {
      allow read: if true;
      allow create: if isEditorPlus();
      // Host control is editor+. Players may bump playerCount on join, or answerCount when they submit.
      allow update: if isEditorPlus()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerCount'])
          && request.resource.data.playerCount is int
          && resource.data.playerCount is int
          && request.resource.data.playerCount == resource.data.playerCount + 1
        )
        || isAnswerCountBump();
      allow delete: if isSuperAdmin();

      match /players/{playerId} {
        allow read: if true;
        // Join: create with score 0 only. Score may rise by at most 2000 per answer.
        allow create: if request.resource.data.score == 0
          && request.resource.data.keys().hasAll(['nickname', 'score', 'joinedAt']);
        allow update: if isEditorPlus() || isPlayerScoreBump();
        allow delete: if isEditorPlus();
      }
      match /answers/{answerId} {
        allow read: if isAdmin();
        allow create: if isQuizAnswerCreate(sessionId, answerId);
        allow update, delete: if false;
      }
    }
    match /quiz_logs/{id} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // ΓöÇΓöÇ GoGo ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
    match /gogo_assistant/{document=**} {
      allow read: if true;
      allow write: if true; // tighten further when visitor auth exists
    }

    // ΓöÇΓöÇ Samsung KB ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
    match /samsung_kb/{document=**} {
      allow read, write: if isAdmin();
    }

    // ΓöÇΓöÇ Analytics / activity logs ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if true; // increment counters from clients; prefer App Check
    }
    match /logs/{document=**} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // ΓöÇΓöÇ Immutable audit logs (Admin SDK only) ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
